# Beispiel für /etc/kryptikk-termin.env (Rechte 600, Besitzer root).
# Nur Platzhalter, echte Werte gehören nie ins Repo.
# Lokal: Kopie als termin/.env (steht in .gitignore).

# Speicher und Listener
TERMIN_DB=/var/lib/kryptikk-termin/termin.sqlite3
TERMIN_HOST=127.0.0.1
TERMIN_PORT=18090

# Mailversand: smtp oder console (console gibt Mails nur auf stdout aus)
MAIL_BACKEND=smtp
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
# starttls (Port 587) oder ssl (Port 465)
SMTP_SECURITY=starttls
SMTP_USER=caller@example.invalid
# App-Passwort des Mail-Anbieters
SMTP_PASSWORD=app-passwort-hier-eintragen
MAIL_FROM=caller@example.invalid
# Empfänger der Benachrichtigung bei neuen Anfragen
NOTIFY_TO=caller@example.invalid

# Dashboard-Login: Hash mit termin/hash-password erzeugen
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$salt$hash
# beliebiger langer Zufallswert (z. B. python3 -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=zufallswert-hier-eintragen

# Cookie nur über HTTPS (lokal ohne HTTPS auf 0 setzen)
COOKIE_SECURE=1
# für den Link in der Benachrichtigungsmail
PUBLIC_BASE_URL=https://kryptikk.de
