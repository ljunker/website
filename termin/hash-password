#!/usr/bin/env python3
"""Erzeugt den scrypt-Hash für ADMIN_PASSWORD_HASH (Passwort per getpass).

Usage: termin/hash-password
       termin/hash-password --password <pw>   nur für Tests, landet sonst in der Shell-History
"""
import getpass
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from app import hash_password  # noqa: E402


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--password":
        password = sys.argv[2]
    elif len(sys.argv) == 1:
        password = getpass.getpass("Passwort: ")
        if password != getpass.getpass("Wiederholen: "):
            sys.exit("Passwörter stimmen nicht überein")
    else:
        sys.exit(__doc__)
    if len(password) < 12:
        print("Hinweis: das Passwort ist kürzer als 12 Zeichen", file=sys.stderr)
    print(hash_password(password))


if __name__ == "__main__":
    main()
