#!/usr/bin/env bash
#
# Print the colorized logo next to my name, role, website and e-mail address,
# used as the header for all pages you can request via `curl`
#
# Basiert auf ysap von Dave Eddy (MIT), siehe NOTICE
#

set -eo pipefail


. ./theme || exit
. ./tools/repeat-char || exit

padding=1
while getopts 'p:' opt; do
	case "$opt" in
		p) padding=$OPTARG;;
		*) exit 1;;
	esac
done

padding=$(repeat-char ' ' "$padding")

mapfile -t logo < <(./make/make-logo)

description=(
	""
	"${COLOR5}Lars Junker$RST"
	"${COLOR5}Caller und IT-Consultant$RST"
	"${COLOR1}https://kryptikk.de$RST"
	"${COLOR1}caller@kryptikk.de$RST"
	""
)

len=${#logo[@]}

for ((i = 0; i < len; i++)); do
	logo_line=${logo[i]}
	desc_line=${description[i]}

	echo "$logo_line$padding$desc_line"
done
