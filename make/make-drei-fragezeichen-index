#!/usr/bin/env bash
#
# Generate the page as seen by `curl kryptikk.de/drei-fragezeichen`
#

set -eo pipefail


. ./theme || exit

format() {
	local nummer titel

	# Kopfzeile
	printf '%s\t%s\n' \
		"${COLOR4}Nummer${RST}" \
		"${COLOR4}Titel${RST}"

	# Datenzeilen
	while IFS=$'\t' read -r nummer titel _; do
		# Schutz gegen leere Zeilen
		[[ -z $nummer ]] && continue
		printf '%s\t%s\n' \
			"$nummer" \
			"$titel"
	done
}

missing_ranges() {
	awk -F '\t' '
		$1 ~ /^[0-9]+$/ && $3 == "nicht gesammelt" { print $1 }
	' | sort -n | awk '
		NR == 1 { start = $1; prev = $1; next }
		{
			curr = $1
			if (curr == prev + 1) { prev = curr; next }
			if (start == prev) {
				out = out (out ? ", " : "") start
			} else {
				out = out (out ? ", " : "") start "-" prev
			}
			start = curr
			prev = curr
		}
		END {
			if (NR == 0) { print "keine"; exit }
			if (start == prev) {
				out = out (out ? ", " : "") start
			} else {
				out = out (out ? ", " : "") start "-" prev
			}
			print out
		}
	'
}

collection_progress() {
	awk -F '\t' '
		$1 ~ /^[0-9]+$/ {
			total++
			if ($3 == "gesammelt") {
				collected++
			}
		}
		END {
			if (total == 0) {
				printf "0 von 0 Folgen (0.0 %%)"
				exit
			}
			printf "%d von %d Folgen (%.1f %%)", collected, total, (collected / total) * 100
		}
	'
}

{
# create the header
./make/make-header -p 7 |
    ./tools/box -hp 4 -T plain |
    ./tools/rtrim-ansi-aware

# fetch the list once and the values first: a failing command substitution
# inside the arguments of printf (or in a pipeline) would not trigger `set -e`,
# a plain assignment does
list=$(./make/make-drei-fragezeichen-list)
progress=$(printf '%s\n' "$list" | collection_progress)
missing=$(printf '%s\n' "$list" | missing_ranges)

echo
printf '%s\t%s\n' "${COLOR4}Gesammelt:${RST}" "$progress"
echo
printf '%s\t%s\n' "${COLOR4}Es fehlen mir:${RST}" "$missing"
echo

# create the table
printf '%s\n' "$list" | \
	awk -F '\t' '$3 == "gesammelt"' | \
    format | \
    ./tools/box -s $'\t' -hp 1 -tc "$COLOR5" -bc "$COLOR4" -t "Gesammelte Folgen" -vp 1

./make/make-legend
} | ./tools/lpad '  ' | ./tools/rtrim-ansi-aware
