#!/usr/bin/env bash
#
# Make the body of the index page for kryptikk.de
#
# Basiert auf ysap von Dave Eddy (MIT), siehe NOTICE
#

set -eo pipefail



. ./theme || exit 1

# fetch the box first so a failure is noticed (errors inside a process
# substitution `< <(...)` would be swallowed)
about=$(./make/make-about |
    ./tools/box -t About -hp 1 -vp 1 -bc "$COLOR4" -tc "$COLOR5" -s '|')
mapfile -t ABOUT <<< "$about"

# get the length of a single "about" line
about_stripped=$(./tools/strip-ansi <<< "${ABOUT[0]}")
about_len=${#about_stripped}

for ((i = 0; i < ${#ABOUT[@]}; i++)); do
	line1=${ABOUT[i]}

	if [[ -z $line1 ]]; then
		line1=$(./tools/repeat-char ' ' "$about_len")
	fi

	echo "$line1"
done
