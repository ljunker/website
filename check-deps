#!/usr/bin/env bash
#
# Ensure the required dep programs are available
#

set -eo pipefail

# Author: Dave Eddy <dave@daveeddy.com>
# Date: March 25, 2024
# License: MIT

code=0

check() {
	echo -n "$*... "
	if ! "$@"; then
		echo 'error'
		code=1
	fi
}

check_py() {
	echo -n "python3 module $1... "
	if .venv/bin/python3 -c "import $1" 2>/dev/null; then
		echo 'ok'
	else
		echo 'error (make venv)'
		code=1
	fi
}

check command -v bash
check command -v curl
check command -v jq
check command -v python3
check command -v shellcheck

echo -n 'venv .venv/bin/python3... '
if [[ -x .venv/bin/python3 ]]; then
	echo 'ok'
else
	echo 'error (make venv)'
	code=1
fi

# Python modules (checked with the venv python, install with: make venv)
check_py PIL
check_py requests
check_py icalevents

exit "$code"
