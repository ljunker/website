#!/usr/bin/env bash
#
# Pull the latest changes and deploy the site
#
# Usage: ./upgrade
#

set -euo pipefail

# Wrapped in a function so bash parses the whole script before running it.
# Otherwise a `git pull` that changes this very file could break the run.
main() {
	cd "$(dirname "${BASH_SOURCE[0]}")"

	echo '==> git pull'
	git pull --ff-only

	# use the project venv if there is one, so build scripts see its modules
	if [[ -f .venv/bin/activate ]]; then
		# shellcheck disable=SC1091
		. .venv/bin/activate
	fi

	echo '==> pip install'
	python3 -m pip install -r requirements.txt

	echo '==> check dependencies'
	make check-deps

	echo '==> build'
	make clean build

	echo '==> nginx config'
	make update-nginx

	echo '==> deploy'
	make deploy

	echo '==> done'
}

main "$@"
exit
