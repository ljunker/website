#!/usr/bin/env bash
#
# Convert the list of events into JSON format - pass an argument to make it
# JSONP instead.
#

set -eo pipefail


varname=$1

baselink='https://kryptikk.de'

# this is an "event" object in the final json
# (`read -d ''` hits EOF before the delimiter and always returns 1, which would
# abort the script under `set -e`, hence the `|| true`)
read -d '' -r json <<-"EOF" || true
{
	"date": $date,
	"time": $time,
	"end_date": $end_date,
	"end_time": $end_time,
	"details": $details,
	"location": $location
}
EOF

# read data - fetch the list first so a failing ./make-list is noticed (errors
# inside a process substitution `< <(...)` would be swallowed)
list=$(./make-list)
objects=()
while IFS=$'\t' read -r date time end_date end_time details location; do
	# `<<<` of an empty list yields one empty line, skip it
	[[ -z $date ]] && continue
	object=$(jq -nc \
		--arg date "$date" \
		--arg time "$time" \
		--arg end_date "$end_date" \
		--arg end_time "$end_time" \
		--arg details "$details" \
		--arg location "$location" \
		"$json"
	) || exit
	objects+=("$object")
done <<< "$list"

# generate output JSON
printf -v now '%(%s)T' -1
output=$(printf '%s\n' "${objects[@]}" | jq -n \
    --argjson date "$now" \
    --arg link "$baselink" \
    '{
        "name": "Lars Junker Calltermine",
        "site": $link,
        "generated": $date,
        "schedule": [inputs]
     }'
)

# print the data (optionally as jsonp if the first arg is set)
if [[ -n $varname ]]; then
	output="const $varname = $output;"
fi
echo "$output"
