# Welche Index-Datei ausgeliefert wird: curl bekommt die Textversion (index.txt),
# alle anderen die HTML-Version. Wird im HTTPS-Block fuer die curl-Weiche genutzt.
map $http_user_agent $kryptikk_index {
    ~^curl  index.txt;
    default index.html;
}

server {
    listen 80;
    listen [::]:80;
    server_name www.kryptikk.de;
    return 301 https://kryptikk.de$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.kryptikk.de;

    ssl_certificate /etc/letsencrypt/live/kryptikk.de/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/kryptikk.de/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    return 301 https://kryptikk.de$request_uri;
}

server {

    root /var/www/kryptikk.de/html;
    index index.html index.htm index.nginx-debian.html;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "DENY";
        add_header X-Content-Type-Options nosniff;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        sub_filter_once off;
        sub_filter random_nonce_value $request_id;

    server_name kryptikk.de;

    access_log /var/log/nginx/kryptikk.de-ssl-access.log;
    error_log /var/log/nginx/kryptikk.de-ssl-error.log;

    client_max_body_size 100m;

    error_page 404 /404.html;

    location /schrittjagd-api/ {
            proxy_pass http://127.0.0.1:18080/;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Kalender-Feed (iCloud) fuer /schedule: der Browser kann ihn wegen fehlender
        # CORS-Header nicht direkt laden, daher ueber diesen Proxy, immer ohne Cache.
        # add_header im location deaktiviert die Vererbung, daher Header erneut setzen.
        location = /schedule/calendar.ics {
            proxy_pass https://p131-caldav.icloud.com/published/2/MTAzODAyMzk0NDkxMDM4MKx0EePtPDXePVZMEANU5wgvh8UiCQKBUo_2X7Xqg9Jh3NtXpIyVy5CqwdHizblJlRvhMBUjjWdRQ3aI_qnXqcw;
            proxy_set_header Host p131-caldav.icloud.com;
            proxy_ssl_server_name on;
            proxy_hide_header Set-Cookie;
            proxy_hide_header Strict-Transport-Security;
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            proxy_hide_header Pragma;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Frame-Options "DENY";
            add_header X-Content-Type-Options nosniff;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            expires off;
        }

        location = /log {
            return 301 /log/$is_args$args;
        }

        location ^~ /log/ {
            proxy_pass http://127.0.0.1:8000/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Prefix /log;
            proxy_set_header Connection "";
            proxy_redirect off;
        }



    location = /ping {
        default_type text/plain;
        return 200 "pong\n";
    }

    location = /ip {
        default_type text/plain;
        return 200 "$remote_addr\n";
    }

    location = /schedule {
        rewrite ^ /schedule/$kryptikk_index last;
    }

    location = /drei-fragezeichen {
        rewrite ^ /drei-fragezeichen/$kryptikk_index last;
    }

    location = /one-piece {
        rewrite ^ /one-piece/$kryptikk_index last;
    }

    location = /dn9lfj {
        rewrite ^ /dn9lfj/$kryptikk_index last;
    }

    location = / {
        rewrite ^ /$kryptikk_index last;
    }

    location = /404.html {
        internal;
    }

    # /help hat keine Dateiendung und enthaelt UTF-8-Zeichen
    location = /help {
        default_type text/plain;
        charset utf-8;
    }

    # Cache-Header. /static/drei.js und /static/one-piece.js werden bei jedem Build
    # neu erzeugt (ohne ?v=), daher fuer /static/ nur 1h.
    location ^~ /static/fonts/ {
        expires 1y;
        try_files $uri =404;
    }

    location ^~ /static/ {
        expires 1h;
        try_files $uri =404;
    }

    location ^~ /images/ {
        expires 30d;
        try_files $uri =404;
    }

    location / {
            try_files $uri $uri/ =404;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/kryptikk.de/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/kryptikk.de/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {

    access_log /var/log/nginx/kryptikk.de-access.log;
    error_log /var/log/nginx/kryptikk.de-error.log;

    # Cloudflare-Real-IP: Quelle https://www.cloudflare.com/ips-v4 und
    # https://www.cloudflare.com/ips-v6, Stand 2026-11-15. Die Liste muss
    # gelegentlich aktualisiert werden. CF-Connecting-IP wird nur akzeptiert, wenn
    # die Anfrage von einer dieser Adressen kommt (sonst bleibt $remote_addr).
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;

    if ($http_x_forwarded_proto = 'http') {
        set $opts "A";
    }

    if ($http_user_agent !~ "^curl") {
        set $opts "${opts}B";
    }

    location = /log {
            return 301 https://$server_name/log/$is_args$args;
        }

        location ^~ /log/ {
            return 301 https://$server_name$request_uri;
        }

    location = /ping {
        default_type text/plain;
        return 200 "pong\n";
    }

    # Kalender-Feed fuer /schedule (siehe HTTPS-Block), auch hier, falls die
    # Anfrage ueber den vorgeschalteten Proxy per HTTP ankommt.
    location = /schedule/calendar.ics {
        proxy_pass https://p131-caldav.icloud.com/published/2/MTAzODAyMzk0NDkxMDM4MKx0EePtPDXePVZMEANU5wgvh8UiCQKBUo_2X7Xqg9Jh3NtXpIyVy5CqwdHizblJlRvhMBUjjWdRQ3aI_qnXqcw;
        proxy_set_header Host p131-caldav.icloud.com;
        proxy_ssl_server_name on;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        proxy_hide_header Pragma;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "DENY";
        add_header X-Content-Type-Options nosniff;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        expires off;
    }

    # $remote_addr ist dank real_ip_header (siehe oben) die Client-IP hinter Cloudflare
    location = /ip {
        default_type text/plain;
        return 200 "$remote_addr\n";
    }

    location = /schedule {
        if ($opts = "AB") {
             return 301 "https://$server_name$request_uri";
        }
        if ($http_user_agent ~ "^curl") {
            rewrite ^(.*) /schedule/index.txt last;
        }
        rewrite ^(.*) /schedule/index.html last;
    }

    location = /drei-fragezeichen {
        if ($opts = "AB") {
             return 301 "https://$server_name$request_uri";
        }
        if ($http_user_agent ~ "^curl") {
            rewrite ^(.*) /drei-fragezeichen/index.txt last;
        }
        rewrite ^(.*) /drei-fragezeichen/index.html last;
    }

    location = /one-piece {
        if ($opts = "AB") {
             return 301 "https://$server_name$request_uri";
        }
        if ($http_user_agent ~ "^curl") {
            rewrite ^(.*) /one-piece/index.txt last;
        }
        rewrite ^(.*) /one-piece/index.html last;
    }

    location = /dn9lfj {
            if ($opts = "AB") {
                 return 301 "https://$server_name$request_uri";
            }
            if ($http_user_agent ~ "^curl") {
                rewrite ^(.*) /dn9lfj/index.txt last;
            }
            rewrite ^(.*) /dn9lfj/index.html last;
        }

    location = /impressum {
        if ($opts = "AB") {
             return 301 "https://$server_name$request_uri";
        }
        rewrite ^(.*) /impressum/index.html last;
    }

    location = /schrittjagd-support {
        if ($opts = "AB") {
             return 301 "https://$server_name$request_uri";
        }
        rewrite ^(.*) /schrittjagd-support/index.html last;
    }

    location = /schrittjagd-datenschutz {
        if ($opts = "AB") {
             return 301 "https://$server_name$request_uri";
        }
        rewrite ^(.*) /schrittjagd-datenschutz/index.html last;
    }

    location = /schrittjagd-delete {
        if ($opts = "AB") {
             return 301 "https://$server_name$request_uri";
        }
        rewrite ^(.*) /schrittjagd-delete/index.html last;
    }

    location = / {
        if ($opts = "AB") {
            return 301 https://$server_name$request_uri;
        }
        if ($http_user_agent ~ "^curl") {
            rewrite ^(.*) /index.txt last;
        }
        rewrite ^(.*) /index.html last;
    }

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    # /help hat keine Dateiendung und enthaelt UTF-8-Zeichen
    location = /help {
        if ($opts = "AB") {
            return 301 https://$server_name$request_uri;
        }
        default_type text/plain;
        charset utf-8;
    }

    # Cache-Header, siehe HTTPS-Block
    location ^~ /static/fonts/ {
        if ($opts = "AB") {
            return 301 https://$server_name$request_uri;
        }
        expires 1y;
        try_files $uri =404;
    }

    location ^~ /static/ {
        if ($opts = "AB") {
            return 301 https://$server_name$request_uri;
        }
        expires 1h;
        try_files $uri =404;
    }

    location ^~ /images/ {
        if ($opts = "AB") {
            return 301 https://$server_name$request_uri;
        }
        expires 30d;
        try_files $uri =404;
    }

    # alle uebrigen Pfade: Browser per HTTPS, curl weiter ueber HTTP
    location / {
        if ($opts = "AB") {
            return 301 https://$server_name$request_uri;
        }
        try_files $uri $uri/ =404;
    }

    listen 80;
    listen [::]:80;

    root /var/www/kryptikk.de/html;

    server_name kryptikk.de;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "DENY";
        add_header X-Content-Type-Options nosniff;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

}
